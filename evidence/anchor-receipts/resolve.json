            "status": "return",
            "payload": {
              "readable": "{\"current_date\":\"2026-11-14\"\"evidence_hash\":\"6d8aff917402f906ceba2b10694814d4d1600d15b6c0618afeb86eba0fea80d4\"\"flags\":[\"false\",\"false\",\"false\",]\"github_sha\":\"8078180b936a512bf1c96d6ceea2dc11e2dfa3e5\"\"original_github_sha\":\"38dac5d9090fb71bd0b121619fa968af4b5026e3\"\"original_quote\":\"All 12 Riverside sensor kits were assembled, installed and completed commissioning.\"\"original_snapshot\":\"# Sensor kit delivery record\\n\\nControlled test document for MilestoneFund validator evaluation, not a report\\nof a real installation or an independent audit.\\n\\nAll 12 Riverside sensor kits were assembled, installed and completed commissioning.\\nFirmware v1.4.2 passed the final 24-hour reporting check on 2026-11-13.\\nDelivery record ID MF-PAIR-001: every sensor reports temperature in degrees Celsius.\\n\"\"original_snapshot_hash\":\"f9dc9c67e9e4cc85b2baceb5a6e4ebb31c19dd485b1b63bf27e458fcb833428e\"\"quote\":\"No Riverside sensor kits were delivered or installed.\"\"rationale\":\"The correction snapshot explicitly refutes the original claim of 12 assembled sensor kits, stating none were delivered or installed.\"\"rebuts_original\":\"true\"\"reference_url\":\"https://raw.githubusercontent.com/xiaoyu7799/crowdfund-milestone-genlayer/463b0ac268e44952c3b9a5f41fe007f4f632d4f0/docs/evidence/paired/counter.md\"\"snapshot\":\"# Correction to delivery record MF-PAIR-001\\n\\nControlled test fixture; this is not a real installation report.\\n\\nNo Riverside sensor kits were delivered or installed.\\n\\nThe original record MF-PAIR-001 falsely described twelve installed sensor kits.\\n\\nThe firmware v1.4.2 commissioning log was simulated, not a completed field test.\\n\\nThere is no completed sensor network and no field measurement confirming delivery.\\n\"\"snapshot_hash\":\"62f2093896a5913b4347bdf0fb827ddb891d9313307a194baa290be555917396\"\"snapshot_len\":412}"
            }
